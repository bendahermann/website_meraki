# ==========================================
# SITIO BASE - VARIABLES DE ENTORNO
# Copia este archivo como .env.local para desarrollo local:
# cp .env.example .env.local
# ==========================================

# URL base del sitio web
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre público del proyecto
NEXT_PUBLIC_SITE_NAME="Nombre de Marca"

# Pasarelas de Pago (Opcionales para modo producción)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# MERCADOPAGO_ACCESS_TOKEN=TEST-...

# Analítica y Telemetría (Opcional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
